{
  "name": "jk-nav",
  "version": "1.1.2",
  "description": "Navigate pages using vim-style keyboard shortcuts.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt -b chrome",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && npm run test:e2e:run",
    "test:e2e:run": "playwright test",
    "test": "npm run build && npm run test:unit && npm run test:e2e:run",
    "bench": "node docs/bench/bench.ts",
    "bench:baseline": "npm run build && docs/bench/docker.sh --baseline",
    "bench:check": "npm run build && docs/bench/docker.sh --check"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wxt": "^0.21.5"
  }
}
