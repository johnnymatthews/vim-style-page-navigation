{
  "manifest_version": 3,
  "name": "Vim-Style Page Navigation",
  "version": "1.1",
  "description": "Navigate pages using vim-style keyboard shortcuts (j/k to scroll, gg/G for top/bottom, f for link hints)",
  "icons": {
    "48": "icons/icon-48.jpg",
    "96": "icons/icon-96.jpg"
  },
  "action": {
    "default_title": "Vim-Style Page Navigation",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["page-navigator.js"]
    }
  ],
  "permissions": ["storage", "activeTab"]
}
